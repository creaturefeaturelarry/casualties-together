	<Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
		<WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.cs" Lines="namespace Together%3B public static class BuildInfo { public const string MOD_VERSION = &quot;$(FullModVersion)&quot;%3B }" Overwrite="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<MakeDir Directories="$(ModPluginOutputDir)" />

		<ItemGroup>
			<BuildOutputFiles Include="$(TargetDir)$(TargetFileName)" />
		</ItemGroup>

		<Copy SourceFiles="@(BuildOutputFiles)" DestinationFolder="$(ModPluginOutputDir)" SkipUnchangedFiles="true" />

		<ItemGroup>
			<LibraryFiles Include="$(SlnRoot)\libs\dlls\*" />
		</ItemGroup>

		<Copy SourceFiles="@(LibraryFiles)" DestinationFolder="$(ModPluginOutputDir)" SkipUnchangedFiles="true" />
		
		
	</Target>

	<Target Name="RunPythonScript" AfterTargets="PostBuildEvent" Condition="('$(Configuration)' == 'Playtest' Or '$(Configuration)' == 'Release') And Exists('$(SlnRoot)scripts/proprietary/build-zip.py')">
		<Exec WorkingDirectory="$(SlnRoot)" Command="python &quot;$(SlnRoot)scripts/proprietary/build-zip.py&quot; &quot;$(Configuration)&quot; &quot;$(FullModVersion)&quot;" />
	</Target>

	<Target Name="CustomClean" BeforeTargets="CoreClean">
		<ItemGroup>
			<_CustomFilesToDelete Include="$(ModPluginOutputDir)\**\*" />
		</ItemGroup>
		<Delete Files="@(_CustomFilesToDelete)" />
	</Target>



</Project>
