<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SolutionDir>$(MSBuildThisFileDirectory)../../</SolutionDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../ScavPrototypeMP/Content/NameFilterMatcher.cs" Link="NameFilterMatcher.cs" />
  </ItemGroup>
  <!-- only builds the matcher so it doesnt need the game installed -->
  <Target Name="EnsureGamePathsResolved" />
</Project>
